<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static base sitemap for Ladha. Hotel pages (/h/:slug) are dynamically
  listed at GET /api/v1/sitemap — submit BOTH to Google Search Console:
    https://ladha.co.ke/sitemap.xml
    https://ladha.co.ke/api/v1/sitemap
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
          http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <!-- Marketplace homepage -->
  <url>
    <loc>https://ladha.co.ke/</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Search page -->
  <url>
    <loc>https://ladha.co.ke/search</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>

</urlset>
