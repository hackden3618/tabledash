{
    "dependencies": {
        "@elysia/openapi": "^1.4.15",
        "@elysiajs/cors": "^1.4.2",
        "@elysiajs/jwt": "^1.4.2",
        "@prisma/adapter-pg": "^7.9.0",
        "@prisma/client": "^7.9.1",
        "dotenv": "^17.4.2",
        "elysia": "^1.4.29",
        "pg": "^8.22.0",
        "prisma": "^7.9.1",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/pg": "^8.20.0",
        "@types/web-push": "^3.6.4"
    },
    "scripts": {
        "server": "bun --watch ./apps/api/server.ts",
        "web": "cd ./apps/web/ && bun run dev",
        "test": "bun test",
        "typecheck": "bunx tsc --noEmit -p apps/api/tsconfig.json && bunx tsc --noEmit -p apps/web/tsconfig.app.json && bunx tsc --noEmit -p apps/web/tsconfig.node.json",
        "validate": "bun run typecheck && bunx prisma validate && bun test"
    }
}
