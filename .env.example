# Application essentials
DATABASE_URL=postgres://development@localhost:5432/tabledash?schema=public&connection_limit=5
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# SMS (use SMS_PROVIDER=console locally to simulate delivery)
SMS_PROVIDER=console
SMS_LOG_MESSAGES=true
# TEXTSMS_API_KEY=your-api-key
# TEXTSMS_PARTNER_ID=your-partner-id
# TEXTSMS_SENDER_ID=your-sender-id

# Local image uploads (default for development)
MEDIA_STORAGE=local
MEDIA_BASE_URL=http://localhost:3000

# Production S3-compatible object storage (set in Railway; leave out of local files)
# MEDIA_STORAGE=s3
# Railway bucket variables are also accepted directly:
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_BUCKET=tabledash_image_bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_PUBLIC_BASE_URL=https://your-public-bucket-or-cdn-origin
# MEDIA_ENDPOINT=https://your-s3-compatible-endpoint
# MEDIA_REGION=auto
# MEDIA_BUCKET=tabledash_image_bucket
# MEDIA_ACCESS_KEY_ID=your-access-key-id
# MEDIA_SECRET_ACCESS_KEY=your-secret-access-key
# Set this when the bucket is exposed through a public endpoint/CDN.
# MEDIA_PUBLIC_BASE_URL=https://images.example.com
