# Application essentials
DATABASE_URL=postgres://development@localhost:5432/ladha?schema=public&connection_limit=5
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# SMS (use SMS_PROVIDER=console locally to simulate delivery)
SMS_PROVIDER=console
SMS_LOG_MESSAGES=true
# TEXTSMS_API_KEY=your-api-key
# TEXTSMS_PARTNER_ID=your-partner-id
# TEXTSMS_SENDER_ID=your-sender-id

# Local image uploads (default for development)
MEDIA_STORAGE=local
MEDIA_BASE_URL=http://localhost:3000

# Production S3-compatible object storage — IDrive e2 (free 10 GB tier).
# Set these in Render (never commit credentials to local files).
# MEDIA_STORAGE=s3
# MEDIA_ENDPOINT=https://s3.eu-west-3.idrivee2.com
# MEDIA_REGION=eu-west-3
# MEDIA_BUCKET=ladha-storage
# MEDIA_ACCESS_KEY_ID=your-idrive-e2-access-key
# MEDIA_SECRET_ACCESS_KEY=your-idrive-e2-secret-key
# Public origin images are served through (application reverse-proxies them at /api/v1/media):
# MEDIA_BASE_URL=https://your-render-app.onrender.com

# Legacy S3_ENDPOINT / S3_BUCKET / S3_* aliases are also accepted directly.
# S3_ENDPOINT=https://s3.eu-west-3.idrivee2.com
# S3_REGION=eu-west-3
# S3_BUCKET=ladha-storage
# S3_ACCESS_KEY_ID=your-idrive-e2-access-key
# S3_SECRET_ACCESS_KEY=your-idrive-e2-secret-key
